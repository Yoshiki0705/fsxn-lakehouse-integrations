#!/bin/bash
# Pre-commit hook: author email check + gitleaks secret scanning
# Setup: git config core.hooksPath .githooks

set -euo pipefail

# === 1. Author email check ===
ALLOWED_EMAIL="40357845+Yoshiki0705@users.noreply.github.com"
CURRENT_EMAIL=$(git config user.email)

if [ "$CURRENT_EMAIL" != "$ALLOWED_EMAIL" ]; then
  echo "❌ ERROR: Git user.email is '$CURRENT_EMAIL'"
  echo "   Expected: '$ALLOWED_EMAIL'"
  echo ""
  echo "   Fix with: git config user.email '$ALLOWED_EMAIL'"
  exit 1
fi

# === 2. gitleaks secret scanning ===
if command -v gitleaks &> /dev/null; then
  echo "🔍 gitleaks: シークレットスキャン実行中..."
  if ! gitleaks protect --staged --config .gitleaks.toml --verbose 2>/dev/null; then
    echo ""
    echo "❌ ERROR: gitleaks がシークレットを検出しました"
    echo "   詳細: gitleaks protect --staged --config .gitleaks.toml --verbose"
    echo "   除外: .gitleaks.toml の allowlist を更新してください"
    exit 1
  fi
  echo "✅ gitleaks: シークレット未検出"
elif command -v pre-commit &> /dev/null; then
  # pre-commit がインストールされている場合はそちらに委譲
  echo "🔍 pre-commit 経由でチェック実行中..."
  pre-commit run gitleaks --hook-stage commit 2>/dev/null || {
    echo "⚠️  pre-commit gitleaks hook failed"
    exit 1
  }
else
  echo "⚠️  gitleaks が未インストールです"
  echo "   Install: brew install gitleaks"
  echo "   Or: pip install pre-commit && pre-commit install"
  # 警告のみ（CI で捕捉するため）
fi

# === 3. zizmor check (GitHub Actions files only) ===
STAGED_WORKFLOWS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.github/(workflows|actions)/' || true)

if [ -n "$STAGED_WORKFLOWS" ] && command -v zizmor &> /dev/null; then
  echo "🔍 zizmor: GitHub Actions セキュリティリント実行中..."
  if ! echo "$STAGED_WORKFLOWS" | xargs zizmor 2>/dev/null; then
    echo ""
    echo "⚠️  zizmor: セキュリティ警告が検出されました"
    echo "   詳細を確認してください（コミットはブロックしません）"
  else
    echo "✅ zizmor: 問題なし"
  fi
fi

# === 4. Tenant identifiers that gitleaks does not catch ===
# gitleaks looks for credential-shaped strings. A Databricks workspace hostname or a bare
# account UUID is not credential-shaped, so it passes gitleaks while still identifying a
# live tenant in a public repository. This was found the hard way on 2026-08-12: values
# committed in May-June 2026 required a full history rewrite plus a host-side purge,
# because editing the file does not remove what is already in history.
STAGED_TEXT=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -vE '^\.private/|^\.githooks/' || true)
if [ -n "$STAGED_TEXT" ]; then
  echo "🔍 tenant identifier scan..."
  # Databricks workspace hostname (dbc-xxxxxxxx-xxxx.cloud.databricks.com).
  # Placeholders such as dbc-xxx / <WORKSPACE_ID> are allowed.
  DBX_HITS=$(echo "$STAGED_TEXT" | xargs grep -nIE 'dbc-[0-9a-f]{8}-[0-9a-f]{4}\.cloud\.databricks\.com' 2>/dev/null || true)
  # Databricks workspace org id in a URL (?o=<16 digits>)
  ORG_HITS=$(echo "$STAGED_TEXT" | xargs grep -nIE '[?&]o=[0-9]{16}' 2>/dev/null || true)
  if [ -n "$DBX_HITS" ] || [ -n "$ORG_HITS" ]; then
    echo ""
    echo "❌ ERROR: a live tenant identifier is staged"
    [ -n "$DBX_HITS" ] && echo "$DBX_HITS" | sed 's/^/   /'
    [ -n "$ORG_HITS" ] && echo "$ORG_HITS" | sed 's/^/   /'
    echo ""
    echo "   Replace with a placeholder: <WORKSPACE_ID>, <WORKSPACE_ORG_ID>"
    echo "   These are not secrets, but they identify a live tenant in a public repo,"
    echo "   and removing them after the fact needs a history rewrite + a GitHub purge."
    exit 1
  fi
  echo "✅ tenant identifier scan: clean"
fi

echo "✅ pre-commit checks passed"

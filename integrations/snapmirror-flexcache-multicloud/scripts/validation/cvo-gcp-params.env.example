# ============================================================================
# CVO on GCP Validation Parameters (Guide 04 / Guide 09)
# Copy to cvo-gcp-params.env and edit with your values.
# ============================================================================

# --- AWS Side (existing FSx for ONTAP cluster) ---
REGION_A="ap-northeast-1"
FS_ID_A="fs-0EXAMPLE1234abcde"
SVM_NAME_A="verification-svm"
SECRET_ARN_A="arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:fsx-ontap-fsxadmin-credentials-XXXXXX"
SSM_INSTANCE_ID="i-0EXAMPLE"

# --- GCP Side (Cloud Volumes ONTAP) ---
GCP_PROJECT="my-project-123456"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
GCP_VPC="cvo-vpc"
GCP_SUBNET="cvo-subnet"
CVO_MGMT_IP="198.51.100.20"
CVO_IC_IP="198.51.100.21"
CVO_SVM_NAME="svm-cvo-gcp"
CVO_USERNAME="admin"
CVO_PASSWORD="CHANGEME"
CVO_AGGR_NAME="aggr1"
CVO_LICENSE_TYPE="capacity-paygo"  # capacity-paygo | ha-capacity-paygo | byol

# --- Network (HA VPN / Cloud Interconnect) ---
# AWS VPN Gateway or Transit Gateway must be connected to GCP Cloud Router.
AWS_VPN_GW_ID="vgw-0EXAMPLE"
GCP_VPN_TUNNEL="vpn-tunnel-aws-01"
# Verify: ping from EC2 to CVO_MGMT_IP must succeed.

# ============================================================================
# Cost estimate:
#   CVO (PAYGO Explore): ~$0.25/hr = ~$6/day (if deleted after test)
#   HA VPN: ~$0.05/hr per tunnel × 2 = ~$2.40/day
#   GCE test instance: ~$0.02/hr
#   AWS side: ~$5 (EC2 + data transfer)
#   Total for 4-hour validation session: ~$3–5
#
# Time:
#   CVO deployment: ~25 minutes (via BlueXP API or Terraform)
#   HA VPN setup: ~15 minutes (if Terraform)
#   Cluster Peering + FlexCache + SnapMirror: ~20 minutes
#   Total E2E: ~60–90 minutes
#
# Prerequisites:
#   - GCP project with Compute Engine API enabled
#   - Service account with roles: compute.admin, iam.serviceAccountUser
#   - HA VPN or Cloud Interconnect between AWS VPC and GCP VPC
#   - CVO deployed (via Terraform/BlueXP — not scripted here)
#   - Firewall rules: allow TCP 11104, 11105, 443, ICMP between clusters
#   - gcloud CLI authenticated
# ============================================================================

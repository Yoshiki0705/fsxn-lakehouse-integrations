# ============================================================================
# On-Premises Validation Parameters (Guide 03 / Guide 08)
# Copy to on-premises-params.env and edit with your values.
# ============================================================================

# --- AWS Side (existing FSx for ONTAP cluster) ---
REGION_A="ap-northeast-1"
FS_ID_A="fs-0EXAMPLE1234abcde"
SVM_NAME_A="verification-svm"
SECRET_ARN_A="arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:fsx-ontap-fsxadmin-credentials-XXXXXX"
SSM_INSTANCE_ID="i-0EXAMPLE"

# --- On-Premises Side ---
ONPREM_MGMT_IP="198.51.100.10"
ONPREM_IC_IP="198.51.100.11"
ONPREM_SVM_NAME="svm-onprem"
ONPREM_USERNAME="admin"
ONPREM_PASSWORD="CHANGEME"
ONPREM_AGGR_NAME="aggr1"

# --- Network ---
# Direct Connect or VPN must be established before running this script.
# Verify: ping from EC2 (SSM_INSTANCE_ID) to ONPREM_MGMT_IP must succeed.
NETWORK_TYPE="direct_connect"  # direct_connect | vpn

# ============================================================================
# Cost estimate:
#   AWS side: ~$5 (EC2 SSM instance + data transfer)
#   On-premises: existing ONTAP system (no additional cost)
#
# Time:
#   Cluster Peering: ~5 minutes
#   FlexCache creation: ~2 minutes
#   SnapMirror initial transfer: depends on data volume
#   Total E2E: ~30–60 minutes
#
# Prerequisites:
#   - Direct Connect or VPN already configured and active
#   - On-premises ONTAP 9.15.1+ (for write-back), or 9.12.1+ (read-only cache)
#   - Intercluster LIF configured on on-premises cluster
#   - Firewall allows TCP 11104, 11105, ICMP between clusters
#   - EC2 (SSM) has network path to on-premises ONTAP management IP
# ============================================================================

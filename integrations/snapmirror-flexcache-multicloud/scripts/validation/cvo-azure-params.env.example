# ============================================================================
# CVO on Azure Validation Parameters (Guide 05 / Guide 10)
# Copy to cvo-azure-params.env and edit with your values.
# ============================================================================

# --- AWS Side (existing FSx for ONTAP cluster) ---
REGION_A="ap-northeast-1"
FS_ID_A="fs-0EXAMPLE1234abcde"
SVM_NAME_A="verification-svm"
SECRET_ARN_A="arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:fsx-ontap-fsxadmin-credentials-XXXXXX"
SSM_INSTANCE_ID="i-0EXAMPLE"

# --- Azure Side (Cloud Volumes ONTAP) ---
AZURE_SUBSCRIPTION="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-cvo-validation"
AZURE_REGION="eastus2"
AZURE_VNET="vnet-cvo"
AZURE_SUBNET="subnet-cvo"
CVO_MGMT_IP="198.51.100.30"
CVO_IC_IP="198.51.100.31"
CVO_SVM_NAME="svm-cvo-azure"
CVO_USERNAME="admin"
CVO_PASSWORD="CHANGEME"
CVO_AGGR_NAME="aggr1"

# --- Network (Azure VPN Gateway ↔ AWS VPN) ---
AZURE_VPN_GW_NAME="vpn-gw-aws"
AWS_VPN_CONNECTION_ID="vpn-0EXAMPLE"
# Verify: ping from EC2 to CVO_MGMT_IP must succeed.

# ============================================================================
# Cost estimate:
#   CVO (PAYGO Explore, Standard_DS4_v2): ~$0.30/hr = ~$7/day
#   Azure VPN Gateway (VpnGw1): ~$0.19/hr = ~$4.50/day
#   AWS side: ~$5 (EC2 + data transfer)
#   Total for 4-hour validation session: ~$4–6
#
# Time:
#   CVO deployment: ~30 minutes
#   Azure VPN Gateway: ~30 minutes (if Terraform)
#   Cluster Peering + FlexCache + SnapMirror: ~20 minutes
#   Total E2E: ~80–120 minutes
#
# Prerequisites:
#   - Azure subscription with Contributor role
#   - Azure VPN Gateway connected to AWS VPN Gateway
#   - CVO deployed on Azure (via Terraform/BlueXP)
#   - NSG rules: allow TCP 11104, 11105, 443, ICMP from AWS CIDR
#   - az CLI authenticated
# ============================================================================

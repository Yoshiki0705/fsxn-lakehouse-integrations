# ============================================================================
# GCNV Validation Parameters (Guide 06 / Guide 11)
# Copy to gcnv-params.env and edit with your values.
# ============================================================================

# --- AWS Side (existing FSx for ONTAP cluster) ---
REGION_A="ap-northeast-1"
FS_ID_A="fs-0EXAMPLE1234abcde"
SVM_NAME_A="verification-svm"
SECRET_ARN_A="arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:fsx-ontap-fsxadmin-credentials-XXXXXX"
SSM_INSTANCE_ID="i-0EXAMPLE"

# --- GCP Side (Google Cloud NetApp Volumes) ---
GCP_PROJECT="my-project-123456"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
GCP_VPC="gcnv-vpc"
GCNV_POOL_NAME="pool-validation"
GCNV_VOLUME_NAME="flexcache-from-fsx"

# GCNV does NOT expose ONTAP REST API directly.
# FlexCache configuration is done via GCP Console / gcloud netapp CLI.
# SnapMirror (External Replication) is also configured via GCP API.

# --- Network (HA VPN between AWS and GCP) ---
# Same HA VPN as CVO GCP — shared tunnel can be used.
# Intercluster LIF of FSx must be reachable from GCNV service network.

# ============================================================================
# Cost estimate:
#   GCNV (Standard, 1TB minimum): ~$0.20/GiB/month (prorated)
#   HA VPN: ~$0.05/hr per tunnel × 2 = ~$2.40/day
#   GCE test instance: ~$0.02/hr
#   Total for 4-hour validation session: ~$5–8
#
# Time:
#   GCNV pool + volume creation: ~10 minutes
#   FlexCache relationship (via GCNV API): ~5 minutes
#   External Replication setup (for Guide 11): ~10 minutes
#   Total E2E: ~60–90 minutes
#
# Prerequisites:
#   - GCP project with NetApp Volumes API enabled
#   - GCNV storage pool in target region
#   - HA VPN between AWS VPC and GCP VPC
#   - gcloud CLI + gcloud netapp plugin
#   - GCNV constraints:
#     * FlexCache: Cache only (cannot be Origin)
#     * FlexCache: NFSv3 access only (no NFSv4)
#     * FlexCache: Read-only (no write-back)
#     * No direct ONTAP REST API access (Google-managed)
# ============================================================================

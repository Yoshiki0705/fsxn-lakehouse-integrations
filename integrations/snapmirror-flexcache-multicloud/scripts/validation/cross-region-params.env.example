# ============================================================================
# Cross-Region Validation Parameters
# Copy to cross-region-params.env and edit with your values.
# ============================================================================

# --- Region A (existing FSx for ONTAP cluster) ---
REGION_A="ap-northeast-1"
FS_ID_A="fs-0EXAMPLE1234abcde"
VPC_ID_A="vpc-0EXAMPLE"
VPC_CIDR_A="10.0.0.0/16"
SECRET_ARN_A="arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:fsx-ontap-fsxadmin-credentials-XXXXXX"
SVM_NAME_A="verification-svm"

# --- Region B (will be created by the deploy script) ---
REGION_B="us-west-2"
VPC_CIDR_B="10.1.0.0/16"
SUBNET_CIDR_B="10.1.0.0/24"
FSX_PASSWORD_B="YourStr0ngP@ssword!"
SVM_NAME_B="svm-region-b"

# ============================================================================
# Cost estimate:
#   FSx for ONTAP (SINGLE_AZ_1, 128 MBps, 1TB): ~$180/month
#   VPC Peering data transfer: $0.01-0.02/GB (cross-region)
#   Total: ~$180/month + data transfer
#
# Time:
#   Deploy: ~50 minutes (FSx creation dominates)
#   Test: ~10 minutes
#   Teardown: ~30 minutes (FSx deletion)
#
# Prerequisites:
#   - Existing FSx for ONTAP in Region A (AVAILABLE)
#   - SVM with at least one volume + SVM Peering capability
#   - AWS CLI configured with permissions to create FSx, VPC, EC2 resources
# ============================================================================

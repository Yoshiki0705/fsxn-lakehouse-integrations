# ============================================================================
# TC-09 Parameters — Copy to params.env and edit with your values
# ============================================================================
# Usage:
#   cp params.env.example params.env
#   vim params.env  # Edit with your actual values
#   ./tc09-deploy-validate-teardown.sh all
# ============================================================================

# --- AWS Region ---
AWS_REGION="ap-northeast-1"

# --- FSx for ONTAP ---
FS_ID="fs-0EXAMPLE1234abcde"                    # File system ID

# --- SVMs (must have SVM Peering already configured) ---
ORIGIN_SVM="verification-svm"                    # SVM hosting Origin Volume
CACHE_SVM="svm_dest"                             # SVM hosting FlexCache Cache Volume

# --- Secrets Manager (fsxadmin credentials) ---
# JSON format: {"username": "fsxadmin", "password": "<your-password>"}
SECRET_ARN="arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:fsx-ontap-fsxadmin-credentials-XXXXXX"

# --- EC2 Instance for SSM execution ---
# Must be in same VPC as FSx for ONTAP, with SSM Agent running
# Required: jq, curl, smbclient (auto-installed by script)
SSM_INSTANCE_ID="i-0EXAMPLE1234abcde"

# --- Volume names (defaults are fine for testing) ---
ORIGIN_VOL="vol_tc09_origin"
CACHE_VOL="vol_tc09_cache"
S3AP_NAME="fsxn-tc09-flexcache"

# --- FlexCache size (bytes) ---
# Minimum 60GB for FSx for ONTAP (FlexGroup + FabricPool)
FLEXCACHE_SIZE="107374182400"  # 100GB

# --- AD Configuration (for SMB testing) ---
# If you skip AD, SMB tests will be skipped automatically
AD_DOMAIN="tc09.flexcache.local"
AD_SHORT="TC09"
CIFS_SERVER="SVMDEST"
CIFS_SHARE="tc09_cache"

# ============================================================================
# Prerequisites checklist:
#   [ ] FSx for ONTAP file system AVAILABLE (ONTAP 9.17.1+)
#   [ ] Two SVMs with SVM Peering (applications: flexcache, snapmirror)
#   [ ] fsxadmin credentials in Secrets Manager
#   [ ] EC2 instance in same VPC with SSM Agent online
#   [ ] (For SMB) AD CFn stack deployed: shared/templates/demo-ad-environment.yaml
#   [ ] (For SMB) Cache SVM joined to AD domain
# ============================================================================
